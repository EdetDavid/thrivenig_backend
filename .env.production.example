# Production environment template
#
# Copy these names into your production platform's environment-variable
# settings (for example, Vercel), or copy this file to `.env` on a traditional
# server (this project loads `.env`). Never commit real credentials.
#
# List values use comma-separated entries without JSON brackets. Do not include
# URL schemes in ALLOWED_HOSTS; CORS and CSRF origins must include https://.
# Replace every `replace-with-...` value before deploying this configuration.

# Django and database (required)
SECRET_KEY=replace-with-a-long-random-production-secret
DEBUG=False
ALLOWED_HOSTS=api.example.com,your-project.vercel.app
DATABASE_URL=postgresql://database_user:database_password@database_host:5432/database_name?sslmode=require

# Browser and proxy security
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# Change this only after verifying the number of trusted proxies in front of Django.
DRF_NUM_PROXIES=0

# Outbound email through Amazon SES
# Both AWS credentials must be present for the app to select the SES backend.
EMAIL_HOST_USER=no-reply@example.com
DEFAULT_FROM_EMAIL=no-reply@example.com
AWS_ACCESS_KEY_ID=replace-with-an-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-an-aws-secret-access-key
AWS_SES_REGION_NAME=us-east-1
AWS_SES_REGION_ENDPOINT=email.us-east-1.amazonaws.com

# Notification recipients (comma-separated)
ADMIN_EMAILS=admin@example.com
TRAVEL_AGENCY_EMAILS=travel@example.com
INSURANCE_AGENCY_EMAILS=insurance@example.com

# Optional AI chatbot; leave OPENAI_API_KEY empty to disable it.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-terra

# Live flight search
FLIGHT_SEARCH_PROVIDER=duffel
DUFFEL_ACCESS_TOKEN=replace-with-a-live-duffel-access-token
DUFFEL_API_BASE_URL=https://api.duffel.com
DUFFEL_API_VERSION=v2
DUFFEL_SUPPLIER_TIMEOUT_MS=15000
FLIGHT_SEARCH_TIMEOUT_SECONDS=25
FLIGHT_SEARCH_RELAX_TLS_STRICT=False
FLIGHT_SEARCH_CACHE_SECONDS=120
FLIGHT_SEARCH_RESULT_LIMIT=50
FLIGHT_LOCATION_CACHE_SECONDS=3600
# Never enable synthetic supplier data in production.
ALLOW_DUFFEL_TEST_DATA=False

# Hotel search
# Use `local` for admin-managed inventory or `duffel` for live Duffel Stays.
HOTEL_SEARCH_PROVIDER=local
ALLOW_HOTEL_TEST_DATA=False
HOTEL_SEARCH_TIMEOUT_SECONDS=30
HOTEL_SEARCH_RELAX_TLS_STRICT=False
HOTEL_SEARCH_CACHE_SECONDS=300
HOTEL_SEARCH_RESULT_LIMIT=50
HOTEL_LOCATION_CACHE_SECONDS=3600
HOTEL_SEARCH_DEFAULT_RADIUS_KM=10

# Hotel currency conversion
HOTEL_FX_API_BASE_URL=https://api.frankfurter.dev/v2
HOTEL_FX_TIMEOUT_SECONDS=5
HOTEL_FX_CACHE_SECONDS=86400
