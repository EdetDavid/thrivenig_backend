# Django
SECRET_KEY=replace-with-a-strong-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
DATABASE_URL=sqlite:///db.sqlite3

# Email
EMAIL_HOST_USER=thriveholdingswebmail@gmail.com
DEFAULT_FROM_EMAIL=thriveholdingswebmail@gmail.com
# Comma-separated recipients for flight fare and hotel request notifications.
TRAVEL_AGENCY_EMAILS=david.edet@thrivenig.com,oluwaremilekun.adebowale@thrivenig.com,kazeem.busari@thrivenig.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_REGION_NAME=us-east-1

# Optional AI chatbot
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-terra

# Optional live flight search and location autocomplete (server-side only)
FLIGHT_SEARCH_PROVIDER=duffel
DUFFEL_ACCESS_TOKEN=
DUFFEL_API_BASE_URL=https://api.duffel.com
DUFFEL_API_VERSION=v2
DUFFEL_SUPPLIER_TIMEOUT_MS=15000
FLIGHT_SEARCH_TIMEOUT_SECONDS=25
# Local Python 3.14 compatibility only; certificate verification remains enabled.
FLIGHT_SEARCH_RELAX_TLS_STRICT=False
FLIGHT_SEARCH_CACHE_SECONDS=120
# Return only the lowest-priced offers. Duffel accepts values from 1 to 200.
FLIGHT_SEARCH_RESULT_LIMIT=50
FLIGHT_LOCATION_CACHE_SECONDS=3600
# Keep false in production so synthetic Duffel flight and Stays data cannot
# reach customers.
ALLOW_DUFFEL_TEST_DATA=False

# Hotel provider: "local" uses admin-managed inventory; "duffel" uses live
# Duffel Stays prices and requires Stays access on the Duffel account.
HOTEL_SEARCH_PROVIDER=local
# In Duffel test mode, type "Duffel test hotels" in the destination field to
# use Duffel's official synthetic-hotel coordinates.
# Keep false outside local QA so seeded test listings are never public.
ALLOW_HOTEL_TEST_DATA=False
HOTEL_SEARCH_TIMEOUT_SECONDS=30
# Local Python 3.14 compatibility only; certificate verification stays enabled.
# Keep false unless hotel requests fail specifically because of strict X.509 flags.
HOTEL_SEARCH_RELAX_TLS_STRICT=False
HOTEL_SEARCH_CACHE_SECONDS=300
HOTEL_SEARCH_RESULT_LIMIT=50
HOTEL_LOCATION_CACHE_SECONDS=3600
HOTEL_SEARCH_DEFAULT_RADIUS_KM=10
# Frankfurter converts non-USD supplier currencies to USD before the
# admin-managed USD-to-NGN rate is applied. The public API needs no key.
HOTEL_FX_API_BASE_URL=https://api.frankfurter.dev/v2
HOTEL_FX_TIMEOUT_SECONDS=5
HOTEL_FX_CACHE_SECONDS=86400
# Verify the actual trusted proxy chain for your host; PythonAnywhere is commonly 1.
DRF_NUM_PROXIES=1
